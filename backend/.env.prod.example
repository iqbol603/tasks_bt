# Production — VPS 217.11.176.136 (Docker)
# На сервере: cp .env.prod.example .env && nano .env
# Замени только ВАШ_ПАРОЛЬ_MYSQL, JWT-секреты, SMTP_PASSWORD и TELEGRAM_BOT_TOKEN

# MySQL на этом же сервере — из Docker только host.docker.internal (не 127.0.0.1 и не внешний IP)
DATABASE_URL="mysql://rps:ВАШ_ПАРОЛЬ_MYSQL@host.docker.internal:3306/rps_tasks"

JWT_SECRET="change-me-in-production-use-long-random-string"
JWT_REFRESH_SECRET="change-me-refresh-secret-in-production"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Порт внутри контейнера (снаружи проброшен как 6065)
PORT=6065
CORS_ORIGIN="http://217.11.176.136:6067"
APP_URL="http://217.11.176.136:6067"
UPLOAD_DIR="/app/uploads"

SMTP_HOST="mail.babilon-t.com"
SMTP_PORT=465
SMTP_USER="senginfo@babilon-t.com"
SMTP_PASSWORD="ВАШ_SMTP_ПАРОЛЬ"
SMTP_FROM="senginfo@babilon-t.com"

TELEGRAM_BOT_TOKEN="ВАШ_TELEGRAM_TOKEN"
TELEGRAM_BOT_USERNAME="tasks_marketingBT_bot"

SCHEDULER_ENABLED=true
DIGEST_HOUR=8
