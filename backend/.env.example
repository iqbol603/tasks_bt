# Database
DATABASE_URL="mysql://rps:rps_password@localhost:3306/rps_tasks"

# Auth
JWT_SECRET="change-me-in-production-use-long-random-string"
JWT_REFRESH_SECRET="change-me-refresh-secret-in-production"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Server
PORT=3001
CORS_ORIGIN="http://localhost:5173"
APP_URL="http://localhost:5173"
UPLOAD_DIR="./uploads"

# Email (SMTP) — опционально
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_USER="your@email.com"
# SMTP_PASS или SMTP_PASSWORD
# SMTP_PASS="your-password"
# SMTP_FROM="RPS Task Manager <noreply@rps.local>"

# Telegram Bot — опционально
# TELEGRAM_BOT_TOKEN="your-bot-token"
# TELEGRAM_BOT_USERNAME="YourBotName"

# MinIO — опционально (без настройки файлы хранятся локально)
# MINIO_ENDPOINT="http://localhost:9000"
# MINIO_BUCKET="rps-files"
# MINIO_ACCESS_KEY="minioadmin"
# MINIO_SECRET_KEY="minioadmin"
# MINIO_REGION="us-east-1"
